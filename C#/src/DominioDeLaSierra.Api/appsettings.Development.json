{
  "Reservations": {
    "SweepEnabled": false,
    "SweepIntervalSeconds": 60,
    "BatchSize": 20,
    "HoldAlertEnabled": false,
    "HoldAlertHours": 24,
    "ProviderReconciliationEnabled": false
  },
  "Checkout": {
    "Access": "Testers"
  },
  "InvoiceIssuance": {
    "Enabled": false,
    "Fictional": false
  },
  "Notifications": {
    "DispatchEnabled": true,
    "IntervalSeconds": 15,
    "BatchSize": 10,
    "Delivery": "Capture",
    "SmtpHost": "127.0.0.1",
    "SmtpPort": 1025
  },
  "Stripe": {
    "SuccessUrl": "http://localhost:4200/checkout/exito",
    "CancelUrl": "http://localhost:4200/checkout/cancelado"
  },
  "PayPal": {
    "ReturnUrl": "http://localhost:4200/checkout/exito",
    "CancelUrl": "http://localhost:4200/checkout/cancelado"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
