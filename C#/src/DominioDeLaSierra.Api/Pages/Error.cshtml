@page "/error/{code:int?}"
@model DominioDeLaSierra.Api.Pages.ErrorModel
@{
    ViewData["Title"] = Model.Title;
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Title · Dominio de la Sierra</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #faf8f4; color: #1d1917; font: 15px/1.5 Calibri, Segoe UI, sans-serif; }
        main { width: min(460px, calc(100% - 32px)); background: #fff; border: 1px solid rgba(29,25,23,.14); border-radius: 14px; padding: 24px; }
        p { margin: 0 0 8px; letter-spacing: .18em; text-transform: uppercase; font-size: 11px; color: #bd9560; }
        h1 { margin: 0 0 12px; font-weight: 500; font-size: 28px; color: #421f25; }
        .lead { margin: 0; letter-spacing: 0; text-transform: none; font-size: 15px; line-height: 1.5; color: #1d1917; }
        .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
        a { display: inline-block; background: #421f25; color: #fff; border-radius: 999px; padding: 10px 18px; font-weight: 600; font-size: 14px; text-decoration: none; }
    </style>
</head>
<body>
    <main>
        <p>Dominio de la Sierra</p>
        <h1>@Model.Title</h1>
        <p class="lead">@Model.Message</p>
        <div class="actions">
            <a href="/">Volver al inicio</a>
            @if (Model.OfferPanel)
            {
                <a href="/admin">Volver al panel</a>
            }
        </div>
    </main>
</body>
</html>
