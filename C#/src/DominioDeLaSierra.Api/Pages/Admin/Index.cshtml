@page "/admin"
@model IndexModel
@{
    ViewData["Title"] = "Catálogo interno";
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Catálogo interno · Dominio de la Sierra</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=ds-signature-4">
    <style>
        :root { --wine:#421f25; --ink:#1d1917; --paper:#faf8f4; --cream:#f2ede4; --gold:#bd9560; --line:rgba(29,25,23,.14); --ok:#2f6b4f; --err:#8b2e35; }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--paper); color: var(--ink); font: 15px/1.5 Calibri, Segoe UI, sans-serif; }
        header { background: var(--wine); color: #faf7f1; padding: 28px 32px; }
        header p { margin: 0 0 6px; letter-spacing: .18em; text-transform: uppercase; font-size: 11px; color: var(--gold); }
        header h1 { margin: 0; font-weight: 500; font-size: 28px; }
        header small { display: block; margin-top: 8px; opacity: .75; }
        nav { padding: 12px 32px; background: #2d1519; }
        nav a { color: #e8d7b8; margin-right: 18px; text-decoration: none; font-size: 13px; }
        .wrap { padding: 28px 32px 48px; }
        .flash { padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; }
        .flash.ok { background: #e7f3ea; color: var(--ok); }
        .flash.err { background: #f8e8e9; color: var(--err); }
        section.card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px; }
        h2 { margin: 0 0 14px; font-size: 18px; color: var(--wine); }
        label { display: block; font-size: 12px; font-weight: 600; margin: 10px 0 4px; }
        input, select, textarea { width: 100%; padding: 9px 10px; border: 1px solid var(--line); border-radius: 8px; font: inherit; background: var(--cream); }
        textarea { min-height: 88px; resize: vertical; }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .check { display: flex; align-items: center; gap: 8px; margin: 14px 0; }
        .check input { width: auto; }
        button { background: var(--wine); color: #fff; border: 0; border-radius: 999px; padding: 10px 18px; font: 600 14px inherit; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
        table.products th, table.products td { vertical-align: middle; }
        table.products .col-text { text-align: left; }
        table.products .col-center { text-align: center; }
        table.products .image-cell { justify-content: center; }
        th { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #6d6560; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; }
        .on { background: #e7f3ea; color: var(--ok); }
        .off { background: #f8e8e9; color: var(--err); }
        code { font-size: 12px; }
        .muted { color: #756c65; font-size: 13px; margin-top: 0; }
        .section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
        .section-head h2 { margin: 0; }
        .section-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; }
        .section-head button { padding: 8px 14px; font-size: 13px; }
        .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin: 0 0 14px; }
        .filters label { margin: 0 0 4px; }
        .filter-field { flex: 1 1 150px; min-width: 140px; }
        .filter-field.grow { flex: 2 1 220px; }
        .filters button, .clear-link { padding: 9px 14px; font-size: 13px; }
        .clear-link { display: inline-block; color: var(--ink); text-decoration: none; border: 1px solid var(--line); border-radius: 999px; background: transparent; }
        .empty-row { color: #756c65; }
        .live-results { position: relative; overflow-anchor: none; }
        .live-results table, .live-results thead, .live-results tbody, .live-results tr, .live-results th, .live-results td { overflow-anchor: none; }
        .filter-status, .filter-error {
            position: absolute; left: 0; bottom: calc(100% + 2px); margin: 0;
            font-size: 12px; line-height: 1.2; background: #fff; z-index: 1; pointer-events: none;
        }
        .filter-status { color: #756c65; }
        .filter-error { pointer-events: auto; }
        body.list-updating, body.list-updating * { overflow-anchor: none !important; }
        .image-cell { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .thumb-frame { width: 64px; height: 64px; border-radius: 8px; background: #eee8df; }
        .thumb-button { display: block; width: 64px; height: 64px; padding: 0; border: 0; border-radius: 8px; background: #eee8df; cursor: pointer; }
        .thumb { display: block; width: 64px; height: 64px; object-fit: contain; object-position: center; border-radius: 8px; background: #eee8df; }
        .thumb-empty { display: grid; place-items: center; color: #756c65; font-size: 10px; line-height: 1.15; font-weight: 600; text-align: center; padding: 4px; }
        .image-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 0; }
        .image-actions form { margin: 0; }
        .image-actions button { padding: 4px 8px; font-size: 11px; white-space: nowrap; }
        .image-actions .danger { background: transparent; color: var(--err); border: 1px solid var(--err); }
        .js-image-form { height: 0; margin: 0; overflow: hidden; }
        .image-file { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
        .modal[hidden] { display: none !important; }
        body:has(.modal:not([hidden])) { overflow: hidden; }
        .modal { position: fixed; inset: 0; z-index: 40; display: grid; place-items: center; padding: 24px; background: rgba(22, 12, 16, .72); }
        .modal-card { width: min(920px, 100%); background: #fff; border-radius: 14px; padding: 18px; }
        .modal-card.compact { width: min(640px, 100%); }
        .import-file-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 8px 0 4px; }
        .import-result h3 { margin: 12px 0 0; font-size: 14px; }
        .import-result ul { margin: 4px 0 0; padding-left: 18px; max-height: 36vh; overflow: auto; }
        .ok-text { color: var(--ok); font-weight: 700; margin: 0; }
        .err-text { color: var(--err); font-weight: 700; margin: 0; }
        .modal-card img { display: block; width: 100%; max-height: 70vh; object-fit: contain; object-position: center; background: #eee8df; border-radius: 8px; }
        .modal-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; }
        .modal-bar strong { color: var(--wine); }
        .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
        .modal-actions .quiet { background: transparent; color: var(--ink); border: 1px solid var(--line); }
        .edit-card { width: min(760px, 100%); max-height: calc(100vh - 48px); overflow: auto; }
        .kind-line { margin: 0 0 8px; }
        .form-error { margin: 0 0 12px; }
        .block-title { margin: 18px 0 0; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--wine); }
        .component-row, .component-head { display: grid; grid-template-columns: minmax(0, 1fr) 96px auto; gap: 8px; align-items: center; }
        .component-head { margin-top: 8px; font-size: 12px; font-weight: 600; }
        .component-row { margin-top: 8px; }
        .component-row button, #edit-add-component, #create-add-component { padding: 8px 12px; font-size: 13px; }
        #create-add-component { margin-top: 10px; }
        .derived-note { margin: 8px 0 0; }
        .modal-card img.create-image-preview { display: block; width: 120px; height: 120px; max-height: 120px; object-fit: contain; object-position: center; background: #eee8df; border-radius: 8px; }
        .create-image-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
        #create-image-pick, #create-image-change, #create-image-clear { padding: 8px 12px; font-size: 13px; }
        .edit-button { padding: 5px 11px; font-size: 12px; white-space: nowrap; }
        .edit-button.danger { background: transparent; color: var(--err); border: 1px solid var(--err); }
        .category-actions { display: flex; flex-wrap: wrap; gap: 6px; }
        .slug-warning { margin-top: 6px; }
        @@media (max-width: 640px) {
            .component-row, .component-head, .row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <partial name="~/Pages/Admin/_AdminHeader.cshtml" />
    <header>
        <p>Dominio de la Sierra · Administración</p>
        <h1>Panel de catálogo</h1>
        <small>Solo Administrator y Manager pueden modificar el catálogo.</small>
    </header>
    <form id="page-antiforgery" hidden>@Html.AntiForgeryToken()</form>
    <div class="wrap">
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="flash ok">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="flash err">@Model.ErrorMessage</div>
        }

        @if (!Model.CanWrite)
        {
            <p class="muted">Tu rol permite consultar el catálogo, no modificarlo.</p>
        }

        <section class="card" style="margin-bottom:22px">
            <div class="section-head">
                <h2>Categorías (<span id="category-count">@Model.CategoryResults.TotalCount</span>)</h2>
                @if (Model.CanWrite)
                {
                    <button type="button" id="open-category">+ Nueva categoría</button>
                }
            </div>
            <p id="category-list-error" class="err-text" hidden></p>
            <form id="category-filters" class="filters" method="get">
                <div class="filter-field grow">
                    <label for="category-query">Buscar</label>
                    <input id="category-query" name="categoryQuery" value="@Model.CategoryQuery" maxlength="@AdminListSearch.MaxLength" placeholder="Nombre o slug" />
                </div>
                <div class="filter-field">
                    <label for="category-active">Estado</label>
                    <select id="category-active" name="categoryActive">
                        <option value="">Todos</option>
                        <option value="true" selected="@IndexModel.SelectedAttr(Model.CategoryActiveValue == "true")">Activas</option>
                        <option value="false" selected="@IndexModel.SelectedAttr(Model.CategoryActiveValue == "false")">Inactivas</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="category-parent-filter">Categoría padre</label>
                    <select id="category-parent-filter" name="categoryParent">
                        <option value="">Cualquiera</option>
                        <option value="none" selected="@IndexModel.SelectedAttr(Model.CategoryRootsOnly)">Sin padre</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@IndexModel.SelectedAttr(Model.CategoryParentId == category.Id)">@category.Name</option>
                        }
                    </select>
                </div>
                @if (Model.ProductQuery is not null)
                {
                    <input type="hidden" name="productQuery" value="@Model.ProductQuery" />
                }
                @if (Model.ProductCategoryId is Guid productCategoryId)
                {
                    <input type="hidden" name="productCategory" value="@productCategoryId" />
                }
                @if (Model.ProductKindValue is not null)
                {
                    <input type="hidden" name="productKind" value="@Model.ProductKindValue" />
                }
                @if (Model.ProductActiveValue is not null)
                {
                    <input type="hidden" name="productActive" value="@Model.ProductActiveValue" />
                }
                <button type="submit">Filtrar</button>
                <a class="clear-link" id="clear-category-filters" href="@Model.ClearCategoryFiltersUrl">Limpiar filtros</a>
            </form>
            <div class="live-results">
            <p id="category-filter-status" class="filter-status" hidden>Buscando…</p>
            <p id="category-filter-error" class="err-text filter-error" hidden></p>
            <table>
                <thead>
                    <tr>
                        <th>Nombre</th><th>Slug</th><th>Padre</th><th>Estado</th>
                        @if (Model.CanWrite)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody id="category-rows">
                <partial name="_CategoryRows" model="Model" />
                </tbody>
            </table>
            </div>
        </section>

        <section class="card">
            <div class="section-head">
                <h2>Productos (<span id="product-count">@Model.ProductResults.TotalCount</span>)</h2>
                @if (Model.CanWrite)
                {
                    <div class="section-actions">
                        <button type="button" id="open-product">+ Nuevo producto</button>
                        <button type="button" id="open-import">Importar productos</button>
                    </div>
                }
            </div>
            <form id="product-filters" class="filters" method="get">
                <div class="filter-field grow">
                    <label for="product-query">Buscar</label>
                    <input id="product-query" name="productQuery" value="@Model.ProductQuery" maxlength="@AdminListSearch.MaxLength" placeholder="Nombre, referencia o descripción" />
                </div>
                <div class="filter-field">
                    <label for="product-category">Categoría</label>
                    <select id="product-category" name="productCategory">
                        <option value="">Todas</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@IndexModel.SelectedAttr(Model.ProductCategoryId == category.Id)">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="product-kind">Tipo</label>
                    <select id="product-kind" name="productKind">
                        <option value="">Todos</option>
                        <option value="Wine" selected="@IndexModel.SelectedAttr(Model.ProductKindValue == "Wine")">Vino</option>
                        <option value="Pack" selected="@IndexModel.SelectedAttr(Model.ProductKindValue == "Pack")">Pack</option>
                        <option value="Standard" selected="@IndexModel.SelectedAttr(Model.ProductKindValue == "Standard")">Estándar</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="product-active">Estado</label>
                    <select id="product-active" name="productActive">
                        <option value="">Todos</option>
                        <option value="true" selected="@IndexModel.SelectedAttr(Model.ProductActiveValue == "true")">Activos</option>
                        <option value="false" selected="@IndexModel.SelectedAttr(Model.ProductActiveValue == "false")">Inactivos</option>
                    </select>
                </div>
                @if (Model.CategoryQuery is not null)
                {
                    <input type="hidden" name="categoryQuery" value="@Model.CategoryQuery" />
                }
                @if (Model.CategoryActiveValue is not null)
                {
                    <input type="hidden" name="categoryActive" value="@Model.CategoryActiveValue" />
                }
                @if (Model.CategoryParentValue is not null)
                {
                    <input type="hidden" name="categoryParent" value="@Model.CategoryParentValue" />
                }
                <button type="submit">Filtrar</button>
                <a class="clear-link" id="clear-product-filters" href="@Model.ClearProductFiltersUrl">Limpiar filtros</a>
            </form>
            <div class="live-results">
            <p id="product-filter-status" class="filter-status" hidden>Buscando…</p>
            <p id="product-filter-error" class="err-text filter-error" hidden></p>
            <table class="products">
                <thead>
                    <tr>
                        <th class="col-text">Referencia</th><th class="col-text">Nombre</th><th class="col-center">Tipo</th><th class="col-center">Categoría</th><th class="col-center">Precio</th><th class="col-center">IVA</th><th class="col-center">Stock</th><th class="col-center">Estado</th><th class="col-center">Actualizado</th>
                        @if (Model.CanWrite)
                        {
                            <th class="col-center">Editar</th>
                        }
                        <th class="col-center">Imagen</th>
                    </tr>
                </thead>
                <tbody id="product-rows">
                <partial name="_ProductRows" model="Model" />
                </tbody>
            </table>
            </div>
        </section>
    </div>
    <div id="image-lightbox" class="modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="image-lightbox-title">
            <div class="modal-bar">
                <strong id="image-lightbox-title">Imagen del producto</strong>
                <button type="button" data-close-lightbox aria-label="Cerrar">×</button>
            </div>
            <img id="image-lightbox-img" alt="" />
            <div class="modal-actions">
                <button type="button" class="quiet" data-close-lightbox>Cerrar</button>
            </div>
        </div>
    </div>
    <div id="image-preview" class="modal" hidden>
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="image-preview-title">
            <div class="modal-bar">
                <strong id="image-preview-title">Previsualización</strong>
                <button type="button" data-close-preview aria-label="Cancelar">×</button>
            </div>
            <img id="image-preview-img" alt="Imagen seleccionada" />
            <div class="modal-actions">
                <button type="button" class="quiet" data-close-preview>Cancelar</button>
                <button type="button" id="image-preview-save">Guardar imagen</button>
            </div>
        </div>
    </div>
    @if (Model.CanWrite)
    {
        <div id="category-modal" class="modal" hidden>
            <div class="modal-card compact" role="dialog" aria-modal="true" aria-labelledby="category-title">
                <div class="modal-bar">
                    <strong id="category-title">Nueva categoría</strong>
                    <button type="button" data-close-category aria-label="Cerrar">×</button>
                </div>
                <form id="category-form" method="post" asp-page-handler="CreateCategory" data-update-url="@Url.Page(null, pageHandler: "UpdateCategory")">
                    <p id="category-error" class="err-text form-error" hidden></p>
                    <p class="muted">Si dejas el slug vacío se genera a partir del nombre.</p>
                    <input type="hidden" id="category-id" name="categoryId" value="" disabled />
                    <label asp-for="InputCategory.Name">Nombre</label>
                    <input asp-for="InputCategory.Name" required maxlength="@CatalogLimits.CategoryNameMaxLength" />
                    <label asp-for="InputCategory.Slug">Slug (opcional)</label>
                    <input asp-for="InputCategory.Slug" maxlength="@CatalogLimits.CategorySlugMaxLength" placeholder="tintos" />
                    <p id="category-slug-warning" class="muted slug-warning" hidden>Cambiar el slug puede afectar a los filtros del catálogo público y a las importaciones de productos.</p>
                    <label asp-for="InputCategory.ParentCategoryId">Categoría padre</label>
                    <select id="category-parent" asp-for="InputCategory.ParentCategoryId">
                        <option value="">Ninguna</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" data-parent="@category.ParentCategoryId">@category.Name</option>
                        }
                    </select>
                    <label class="check"><input asp-for="InputCategory.Active" /> Activa</label>
                    <div class="modal-actions">
                        <button type="button" class="quiet" data-close-category>Cancelar</button>
                        <button type="submit" id="category-save">Crear categoría</button>
                    </div>
                </form>
            </div>
        </div>
        <div id="product-modal" class="modal" hidden>
            <div class="modal-card edit-card" role="dialog" aria-modal="true" aria-labelledby="product-title">
                <div class="modal-bar">
                    <strong id="product-title">Nuevo producto</strong>
                    <button type="button" data-close-product aria-label="Cerrar">×</button>
                </div>
                <form id="product-form" method="post" enctype="multipart/form-data" asp-page-handler="CreateProduct" data-candidates-url="@Url.Page(null, pageHandler: "ProductCandidates")">
                    <p id="product-error" class="err-text form-error" hidden></p>
                    <p class="muted">El listado público solo muestra productos y categorías activos.</p>
                    <label for="create-kind">Tipo de producto</label>
                    <select asp-for="InputProduct.Kind" id="create-kind">
                        <option value="Standard">Estándar</option>
                        <option value="Wine">Vino</option>
                        <option value="Pack">Pack</option>
                    </select>
                    <h3 class="block-title">Datos generales</h3>
                    <div class="row">
                        <div>
                            <label asp-for="InputProduct.Reference">Referencia</label>
                            <input asp-for="InputProduct.Reference" required maxlength="@CatalogLimits.ProductReferenceMaxLength" placeholder="CRZ-002" />
                        </div>
                        <div>
                            <label asp-for="InputProduct.CategoryId">Categoría</label>
                            <select asp-for="InputProduct.CategoryId" required>
                                <option value="">Selecciona…</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name (@category.Slug)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <label asp-for="InputProduct.Name">Nombre</label>
                    <input asp-for="InputProduct.Name" required maxlength="@CatalogLimits.ProductNameMaxLength" />
                    <label asp-for="InputProduct.Slug">Slug (opcional)</label>
                    <input asp-for="InputProduct.Slug" maxlength="@CatalogLimits.ProductSlugMaxLength" placeholder="vino-reserva" />
                    <label asp-for="InputProduct.Description">Descripción</label>
                    <textarea asp-for="InputProduct.Description" maxlength="@CatalogLimits.ProductDescriptionMaxLength"></textarea>
                    <div class="row">
                        <div>
                            <label asp-for="InputProduct.Price">Precio (€)</label>
                            <input asp-for="InputProduct.Price" required maxlength="16" inputmode="decimal" placeholder="18,90" />
                        </div>
                        <div>
                            <label asp-for="InputProduct.VatRate">IVA (%)</label>
                            <input asp-for="InputProduct.VatRate" required maxlength="6" inputmode="decimal" />
                        </div>
                    </div>
                    <label class="check"><input asp-for="InputProduct.Active" /> Activo en el catálogo público</label>
                    <div id="create-wine" hidden>
                        <h3 class="block-title">Datos del vino</h3>
                        <div class="row">
                            <div>
                                <label asp-for="InputProduct.Vintage">Añada</label>
                                <input asp-for="InputProduct.Vintage" maxlength="@CatalogLimits.WineVintageMaxLength" />
                            </div>
                            <div>
                                <label asp-for="InputProduct.Grape">Uva</label>
                                <input asp-for="InputProduct.Grape" maxlength="@CatalogLimits.WineGrapeMaxLength" />
                            </div>
                        </div>
                        <label asp-for="InputProduct.Alcohol">Graduación alcohólica (%)</label>
                        <input asp-for="InputProduct.Alcohol" maxlength="6" inputmode="decimal" placeholder="13,50" />
                    </div>
                    <div id="create-inventory">
                        <h3 class="block-title">Inventario</h3>
                        <div id="create-stock">
                            <label asp-for="InputProduct.InitialStock">Stock inicial</label>
                            <input asp-for="InputProduct.InitialStock" type="number" inputmode="numeric" min="0" max="@InventoryLimits.MaxStockQuantity" step="1" />
                        </div>
                        <p id="create-derived" class="derived-note" hidden>Stock: <strong>Derivado</strong></p>
                    </div>
                    <div id="create-pack" hidden>
                        <h3 class="block-title">Composición del pack</h3>
                        <div class="component-head">
                            <span>Producto</span>
                            <span>Cantidad</span>
                            <span></span>
                        </div>
                        <div id="create-components"></div>
                        <button type="button" id="create-add-component">+ Añadir producto</button>
                        <input type="hidden" asp-for="InputProduct.ComponentsJson" id="create-components-json" />
                    </div>
                    <div id="create-image">
                        <h3 class="block-title">Imagen principal</h3>
                        <input id="create-image-file" class="image-file" type="file" name="primaryImage" accept="image/jpeg,image/png,image/webp" />
                        <div id="create-image-empty">
                            <button type="button" id="create-image-pick">Seleccionar imagen</button>
                        </div>
                        <div id="create-image-chosen" hidden>
                            <img id="create-image-preview" class="create-image-preview" alt="Imagen seleccionada" />
                            <div class="create-image-actions">
                                <button type="button" id="create-image-change">Cambiar</button>
                                <button type="button" id="create-image-clear">Quitar</button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="quiet" data-close-product>Cancelar</button>
                        <button type="submit" id="product-save">Crear producto</button>
                    </div>
                </form>
            </div>
        </div>
        <div id="import-modal" class="modal" hidden>
            <div class="modal-card compact" role="dialog" aria-modal="true" aria-labelledby="import-title">
                <div class="modal-bar">
                    <strong id="import-title">Importar productos desde JSON</strong>
                    <button type="button" data-close-import aria-label="Cerrar">×</button>
                </div>
                <p class="muted">Selecciona el fichero, valídalo y, si es correcto, impórtalo. La validación no crea productos.</p>
                <form id="import-form" method="post" asp-page-handler="ImportProducts" enctype="multipart/form-data" data-validate-url="@Url.Page(null, pageHandler: "ValidateProductImport")">
                    <div class="import-file-row">
                        <button type="button" id="import-pick">Seleccionar archivo</button>
                        <span id="import-file-name" class="muted">Ningún archivo seleccionado</span>
                    </div>
                    <input id="import-file" class="image-file" type="file" name="importFile" />
                    <div id="import-result" class="import-result"></div>
                    <div class="modal-actions">
                        <button type="button" class="quiet" data-close-import>Cerrar</button>
                        <button type="button" id="import-validate">Validar</button>
                        <button type="button" id="import-confirm" hidden>Importar productos</button>
                    </div>
                </form>
            </div>
        </div>
    }
    @if (Model.CanWrite)
    {
        <div id="edit-modal" class="modal" hidden>
            <div class="modal-card edit-card" role="dialog" aria-modal="true" aria-labelledby="edit-title">
                <div class="modal-bar">
                    <strong id="edit-title">Editar producto</strong>
                    <button type="button" data-close-edit aria-label="Cerrar">×</button>
                </div>
                <p id="edit-loading" class="muted">Cargando la ficha…</p>
                <p id="edit-error" class="err-text form-error" hidden></p>
                <form id="edit-form" novalidate hidden data-save-url="@Url.Page(null, pageHandler: "EditProduct")">
                    <p class="kind-line">Tipo: <strong id="edit-kind"></strong></p>
                    <div class="row">
                        <div>
                            <label for="edit-reference">Referencia</label>
                            <input id="edit-reference" maxlength="@CatalogLimits.ProductReferenceMaxLength" />
                        </div>
                        <div>
                            <label for="edit-category">Categoría</label>
                            <select id="edit-category">
                                <option value="">Selecciona…</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name (@category.Slug)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <label for="edit-name">Nombre</label>
                    <input id="edit-name" maxlength="@CatalogLimits.ProductNameMaxLength" />
                    <label for="edit-slug">Slug (opcional)</label>
                    <input id="edit-slug" maxlength="@CatalogLimits.ProductSlugMaxLength" />
                    <label for="edit-description">Descripción</label>
                    <textarea id="edit-description" maxlength="@CatalogLimits.ProductDescriptionMaxLength"></textarea>
                    <div class="row">
                        <div>
                            <label for="edit-price">Precio (€)</label>
                            <input id="edit-price" maxlength="16" inputmode="decimal" />
                        </div>
                        <div>
                            <label for="edit-vat">IVA (%)</label>
                            <input id="edit-vat" maxlength="6" inputmode="decimal" />
                        </div>
                    </div>
                    <div id="edit-wine" hidden>
                        <div class="row">
                            <div>
                                <label for="edit-vintage">Añada</label>
                                <input id="edit-vintage" maxlength="@CatalogLimits.WineVintageMaxLength" />
                            </div>
                            <div>
                                <label for="edit-grape">Uva</label>
                                <input id="edit-grape" maxlength="@CatalogLimits.WineGrapeMaxLength" />
                            </div>
                        </div>
                        <label for="edit-alcohol">Grado alcohólico (%)</label>
                        <input id="edit-alcohol" maxlength="6" inputmode="decimal" />
                    </div>
                    <div id="edit-stock" hidden>
                        <label for="edit-stock-input">Stock actual</label>
                        <input id="edit-stock-input" type="number" inputmode="numeric" min="0" max="@InventoryLimits.MaxStockQuantity" step="1" />
                    </div>
                    <div id="edit-pack" hidden>
                        <p class="kind-line">Stock: <strong>Derivado</strong></p>
                        <label>Composición</label>
                        <div id="edit-components"></div>
                        <button type="button" id="edit-add-component">Añadir componente</button>
                    </div>
                    <label class="check"><input id="edit-active" type="checkbox" /> Activo en el catálogo público</label>
                    <div class="modal-actions">
                        <button type="button" class="quiet" data-close-edit>Cancelar</button>
                        <button type="submit" id="edit-save">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    }
    <script src="/js/admin-live-filters.js"></script>
    <script>
        (function () {
            const lightbox = document.getElementById('image-lightbox');
            const lightboxImg = document.getElementById('image-lightbox-img');
            const preview = document.getElementById('image-preview');
            const previewImg = document.getElementById('image-preview-img');
            let previewForm = null;
            let previewInput = null;

            const productRows = document.getElementById('product-rows');
            if (productRows) {
                productRows.addEventListener('click', function (event) {
                    const light = event.target.closest('[data-open-lightbox]');
                    if (light) {
                        lightboxImg.src = light.getAttribute('data-full');
                        lightboxImg.alt = light.getAttribute('data-alt') || '';
                        lightbox.hidden = false;
                        return;
                    }
                    const pick = event.target.closest('.js-pick-image');
                    if (!pick) return;
                    const form = document.getElementById(pick.getAttribute('data-form'));
                    const input = form && form.querySelector('input[type="file"]');
                    if (input) input.click();
                });
                productRows.addEventListener('change', function (event) {
                    const input = event.target;
                    if (!input.matches || !input.matches('.js-image-form input[type="file"]')) return;
                    const file = input.files && input.files[0];
                    if (!file) return;
                    previewForm = input.form;
                    previewInput = input;
                    const reader = new FileReader();
                    reader.onload = function () {
                        previewImg.src = reader.result;
                        preview.hidden = false;
                    };
                    reader.readAsDataURL(file);
                });
            }

            document.getElementById('image-preview-save').addEventListener('click', function () {
                if (previewForm) previewForm.submit();
            });

            function closePreview() {
                if (previewInput) previewInput.value = '';
                previewImg.removeAttribute('src');
                preview.hidden = true;
                previewForm = null;
                previewInput = null;
            }

            function closeLightbox() {
                lightbox.hidden = true;
                lightboxImg.removeAttribute('src');
            }

            document.querySelectorAll('[data-close-lightbox]').forEach(function (element) {
                element.addEventListener('click', closeLightbox);
            });
            document.querySelectorAll('[data-close-preview]').forEach(function (element) {
                element.addEventListener('click', closePreview);
            });
            lightbox.addEventListener('click', function (event) {
                if (event.target === lightbox) closeLightbox();
            });
            preview.addEventListener('click', function (event) {
                if (event.target === preview) closePreview();
            });
            const importModal = document.getElementById('import-modal');
            const editModal = document.getElementById('edit-modal');
            let editBusy = false;
            function closeImport() {
                if (importModal) importModal.hidden = true;
            }
            function closeEdit() {
                if (editBusy || !editModal) return;
                editModal.hidden = true;
            }

            function bindWriteModal(config) {
                const modal = document.getElementById(config.id);
                if (!modal) return null;
                const form = modal.querySelector('form');
                const error = document.getElementById(config.errorId);
                const submit = form.querySelector('[type="submit"]');
                let busy = false;

                function showError(message) {
                    error.textContent = message || '';
                    error.hidden = !message;
                }

                function resolveFallback() {
                    return typeof config.fallback === 'function' ? config.fallback() : config.fallback;
                }

                function closeModal() {
                    if (busy) return;
                    modal.hidden = true;
                    form.reset();
                    showError('');
                    if (config.onReset) config.onReset();
                }

                document.getElementById(config.openId).addEventListener('click', function () {
                    if (busy) return;
                    form.reset();
                    showError('');
                    if (config.onReset) config.onReset();
                    if (config.onOpen) config.onOpen();
                    modal.hidden = false;
                    const field = form.querySelector('[name="' + config.focusName + '"]');
                    if (field) field.focus();
                });
                modal.querySelectorAll(config.closeSelector).forEach(function (element) {
                    element.addEventListener('click', closeModal);
                });
                modal.addEventListener('click', function (event) {
                    if (event.target === modal) closeModal();
                });
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    if (busy) return;
                    if (config.beforeSubmit) config.beforeSubmit();
                    busy = true;
                    submit.disabled = true;
                    showError('');
                    fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            }).catch(function () {
                                return { ok: false, data: null };
                            });
                        })
                        .then(function (result) {
                            if (result.ok && result.data && result.data.ok) {
                                window.location.assign(window.location.href);
                                return;
                            }
                            busy = false;
                            submit.disabled = false;
                            showError((result.data && result.data.message) || resolveFallback());
                        })
                        .catch(function () {
                            busy = false;
                            submit.disabled = false;
                            showError(resolveFallback());
                        });
                });

                return {
                    close: closeModal,
                    isOpen: function () { return !modal.hidden; }
                };
            }

            const categoryForm = document.getElementById('category-form');
            const categoryCreateAction = categoryForm ? categoryForm.action : '';
            const categoryIdField = document.getElementById('category-id');
            const categoryDeleteUrl = '@Url.Page(null, pageHandler: "DeleteCategory")';

            function categoryParentSelect() {
                return categoryForm ? categoryForm.querySelector('[name="InputCategory.ParentCategoryId"]') : null;
            }

            function resetCategoryParents() {
                const select = categoryParentSelect();
                if (!select) return;
                Array.from(select.options).forEach(function (option) {
                    option.disabled = false;
                    option.hidden = false;
                });
            }

            function blockCategoryParents(categoryId) {
                const select = categoryParentSelect();
                if (!select || !categoryId) return;
                const children = {};
                Array.from(select.options).forEach(function (option) {
                    if (!option.value) return;
                    const parentId = option.getAttribute('data-parent') || '';
                    if (!children[parentId]) children[parentId] = [];
                    children[parentId].push(option.value);
                });
                const blocked = {};
                const stack = [categoryId];
                blocked[categoryId] = true;
                while (stack.length) {
                    const current = stack.pop();
                    (children[current] || []).forEach(function (childId) {
                        if (blocked[childId]) return;
                        blocked[childId] = true;
                        stack.push(childId);
                    });
                }
                Array.from(select.options).forEach(function (option) {
                    const block = !!option.value && !!blocked[option.value];
                    option.disabled = block;
                    option.hidden = block;
                });
            }

            function setCategoryMode(editing) {
                if (!categoryForm) return;
                document.getElementById('category-title').textContent = editing ? 'Editar categoría' : 'Nueva categoría';
                document.getElementById('category-save').textContent = editing ? 'Guardar cambios' : 'Crear categoría';
                document.getElementById('category-slug-warning').hidden = !editing;
                categoryForm.action = editing ? categoryForm.getAttribute('data-update-url') : categoryCreateAction;
                if (!categoryIdField) return;
                categoryIdField.disabled = !editing;
                if (!editing) {
                    categoryIdField.value = '';
                    resetCategoryParents();
                }
            }

            const categoryModal = bindWriteModal({
                id: 'category-modal',
                openId: 'open-category',
                errorId: 'category-error',
                focusName: 'InputCategory.Name',
                closeSelector: '[data-close-category]',
                fallback: function () {
                    return categoryIdField && !categoryIdField.disabled
                        ? 'No se ha podido guardar la categoría.'
                        : 'No se ha podido crear la categoría.';
                },
                onReset: function () {
                    setCategoryMode(false);
                }
            });

            if (categoryForm) {
                const categoryRows = document.getElementById('category-rows');
                if (categoryRows) categoryRows.addEventListener('click', function (event) {
                    const edit = event.target.closest('.js-edit-category');
                    if (edit) {
                        categoryForm.reset();
                        setCategoryMode(true);
                        const categoryId = edit.getAttribute('data-id') || '';
                        categoryIdField.value = categoryId;
                        categoryForm.querySelector('[name="InputCategory.Name"]').value = edit.getAttribute('data-name') || '';
                        categoryForm.querySelector('[name="InputCategory.Slug"]').value = edit.getAttribute('data-slug') || '';
                        const active = categoryForm.querySelector('input[type="checkbox"][name="InputCategory.Active"]');
                        if (active) active.checked = edit.getAttribute('data-active') === 'true';
                        resetCategoryParents();
                        blockCategoryParents(categoryId);
                        const parentSelect = categoryParentSelect();
                        const parentId = edit.getAttribute('data-parent') || '';
                        if (parentSelect) {
                            parentSelect.value = parentId;
                            if (parentSelect.value !== parentId) parentSelect.value = '';
                        }
                        document.getElementById('category-error').hidden = true;
                        document.getElementById('category-modal').hidden = false;
                        categoryForm.querySelector('[name="InputCategory.Name"]').focus();
                        return;
                    }

                    const toggle = event.target.closest('.js-toggle-category');
                    if (toggle) {
                        const name = toggle.getAttribute('data-name') || 'esta categoría';
                        const isActive = toggle.getAttribute('data-active') === 'true';
                        if (isActive && !window.confirm('Desactivar «' + name + '» oculta sus productos y sus categorías descendientes en la tienda pública. Los productos y las subcategorías conservan su estado. ¿Continuar?')) return;
                        const error = document.getElementById('category-list-error');
                        const tokenInput = document.querySelector('#page-antiforgery input[name="__RequestVerificationToken"]');
                        const body = new FormData();
                        body.append('categoryId', toggle.getAttribute('data-id') || '');
                        body.append('InputCategory.Name', toggle.getAttribute('data-name') || '');
                        body.append('InputCategory.Slug', toggle.getAttribute('data-slug') || '');
                        body.append('InputCategory.ParentCategoryId', toggle.getAttribute('data-parent') || '');
                        body.append('InputCategory.Active', isActive ? 'false' : 'true');
                        body.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
                        toggle.disabled = true;
                        fetch(categoryForm.getAttribute('data-update-url'), {
                            method: 'POST',
                            body: body,
                            credentials: 'same-origin',
                            headers: { 'Accept': 'application/json' }
                        }).then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            }).catch(function () {
                                return { ok: false, data: null };
                            });
                        }).then(function (result) {
                            if (result.ok && result.data && result.data.ok) {
                                window.location.assign(window.location.href);
                                return;
                            }
                            toggle.disabled = false;
                            error.textContent = (result.data && result.data.message) || 'No se ha podido cambiar el estado de la categoría.';
                            error.hidden = false;
                        }).catch(function () {
                            toggle.disabled = false;
                            error.textContent = 'No se ha podido cambiar el estado de la categoría.';
                            error.hidden = false;
                        });
                        return;
                    }

                    const remove = event.target.closest('.js-delete-category');
                    if (!remove) return;
                    const name = remove.getAttribute('data-name') || 'esta categoría';
                    if (!window.confirm('¿Eliminar la categoría «' + name + '»?')) return;
                    const error = document.getElementById('category-list-error');
                    const tokenInput = document.querySelector('#page-antiforgery input[name="__RequestVerificationToken"]');
                    const body = new FormData();
                    body.append('categoryId', remove.getAttribute('data-id') || '');
                    body.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
                    remove.disabled = true;
                    fetch(categoryDeleteUrl, {
                        method: 'POST',
                        body: body,
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    }).then(function (response) {
                        return response.json().then(function (data) {
                            return { ok: response.ok, data: data };
                        }).catch(function () {
                            return { ok: false, data: null };
                        });
                    }).then(function (result) {
                        if (result.ok && result.data && result.data.ok) {
                            window.location.assign(window.location.href);
                            return;
                        }
                        remove.disabled = false;
                        error.textContent = (result.data && result.data.message) || 'No se ha podido eliminar la categoría.';
                        error.hidden = false;
                    }).catch(function () {
                        remove.disabled = false;
                        error.textContent = 'No se ha podido eliminar la categoría.';
                        error.hidden = false;
                    });
                });
            }
            const productForm = document.getElementById('product-form');
            let createCandidates = null;
            let createCandidatesRequest = null;

            function syncCreateKind() {
                if (!productForm) return;
                const kind = document.getElementById('create-kind').value;
                document.getElementById('create-wine').hidden = kind !== 'Wine';
                document.getElementById('create-stock').hidden = kind === 'Pack';
                document.getElementById('create-derived').hidden = kind !== 'Pack';
                document.getElementById('create-pack').hidden = kind !== 'Pack';
                const stockInput = document.querySelector('#create-stock input');
                if (stockInput) stockInput.disabled = kind === 'Pack';
            }

            function candidateLabel(candidate) {
                const label = candidate.reference + ' — ' + candidate.name;
                return candidate.active ? label : label + ' (inactivo)';
            }

            function ensureCreateCandidates() {
                if (createCandidates) return Promise.resolve(createCandidates);
                if (createCandidatesRequest) return createCandidatesRequest;
                createCandidatesRequest = fetch(productForm.getAttribute('data-candidates-url'), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                }).then(function (response) {
                    if (!response.ok) throw new Error();
                    return response.json();
                }).then(function (data) {
                    createCandidates = (Array.isArray(data) ? data : []).filter(function (candidate) {
                        return candidate.kind === 'Standard' || candidate.kind === 'Wine';
                    });
                    createCandidatesRequest = null;
                    return createCandidates;
                }).catch(function (error) {
                    createCandidatesRequest = null;
                    throw error;
                });
                return createCandidatesRequest;
            }

            function addCreateComponentRow(productId, quantity) {
                const row = document.createElement('div');
                row.className = 'component-row';
                const select = document.createElement('select');
                (createCandidates || []).forEach(function (candidate) {
                    const option = document.createElement('option');
                    option.value = candidate.id;
                    option.textContent = candidateLabel(candidate);
                    if (candidate.id === productId) option.selected = true;
                    select.appendChild(option);
                });
                if (productId) select.value = productId;
                const quantityInput = document.createElement('input');
                quantityInput.type = 'number';
                quantityInput.inputMode = 'numeric';
                quantityInput.value = String(quantity || 1);
                const remove = document.createElement('button');
                remove.type = 'button';
                remove.textContent = 'Eliminar';
                remove.addEventListener('click', function () {
                    row.remove();
                });
                row.appendChild(select);
                row.appendChild(quantityInput);
                row.appendChild(remove);
                document.getElementById('create-components').appendChild(row);
            }

            function clearCreateImage() {
                const input = document.getElementById('create-image-file');
                const preview = document.getElementById('create-image-preview');
                const empty = document.getElementById('create-image-empty');
                const chosen = document.getElementById('create-image-chosen');
                if (!input || !preview || !empty || !chosen) return;
                input.value = '';
                preview.removeAttribute('src');
                empty.hidden = false;
                chosen.hidden = true;
            }

            function showCreateImage(file) {
                const reader = new FileReader();
                reader.onload = function () {
                    document.getElementById('create-image-preview').src = reader.result;
                    document.getElementById('create-image-empty').hidden = true;
                    document.getElementById('create-image-chosen').hidden = false;
                };
                reader.readAsDataURL(file);
            }

            function writeCreateComponents() {
                const rows = Array.from(document.querySelectorAll('#create-components .component-row')).map(function (row) {
                    return {
                        productId: row.querySelector('select').value,
                        quantity: Number(row.querySelector('input').value)
                    };
                });
                document.getElementById('create-components-json').value = JSON.stringify(rows);
            }

            const productModal = bindWriteModal({
                id: 'product-modal',
                openId: 'open-product',
                errorId: 'product-error',
                focusName: 'InputProduct.Kind',
                closeSelector: '[data-close-product]',
                fallback: 'No se ha podido crear el producto.',
                onReset: function () {
                    const list = document.getElementById('create-components');
                    if (list) list.replaceChildren();
                    syncCreateKind();
                    clearCreateImage();
                },
                onOpen: function () {
                    ensureCreateCandidates().catch(function () {
                        createCandidates = null;
                    });
                },
                beforeSubmit: writeCreateComponents
            });

            if (productForm) {
                const createImageInput = document.getElementById('create-image-file');
                document.getElementById('create-image-pick').addEventListener('click', function () {
                    createImageInput.click();
                });
                document.getElementById('create-image-change').addEventListener('click', function () {
                    createImageInput.click();
                });
                document.getElementById('create-image-clear').addEventListener('click', clearCreateImage);
                createImageInput.addEventListener('change', function () {
                    const file = createImageInput.files && createImageInput.files[0];
                    if (!file) return;
                    showCreateImage(file);
                });
                document.getElementById('create-kind').addEventListener('change', syncCreateKind);
                document.getElementById('create-add-component').addEventListener('click', function () {
                    const error = document.getElementById('product-error');
                    ensureCreateCandidates().then(function (candidates) {
                        if (!candidates.length) {
                            error.textContent = 'No hay productos disponibles para componer el pack.';
                            error.hidden = false;
                            return;
                        }
                        const used = Array.from(document.querySelectorAll('#create-components select')).map(function (select) {
                            return select.value;
                        });
                        const next = candidates.find(function (candidate) {
                            return used.indexOf(candidate.id) === -1;
                        }) || candidates[0];
                        addCreateComponentRow(next.id, 1);
                    }).catch(function () {
                        error.textContent = 'No se han podido cargar los productos del catálogo.';
                        error.hidden = false;
                    });
                });
            }

            document.addEventListener('keydown', function (event) {
                if (event.key !== 'Escape') return;
                if (!preview.hidden) { closePreview(); return; }
                if (editModal && !editModal.hidden) { closeEdit(); return; }
                if (productModal && productModal.isOpen()) { productModal.close(); return; }
                if (categoryModal && categoryModal.isOpen()) { categoryModal.close(); return; }
                if (importModal && !importModal.hidden) { closeImport(); return; }
                if (!lightbox.hidden) closeLightbox();
            });

            if (importModal) {
                const importForm = document.getElementById('import-form');
                const importInput = document.getElementById('import-file');
                const importName = document.getElementById('import-file-name');
                const importResult = document.getElementById('import-result');
                const importConfirm = document.getElementById('import-confirm');
                const importValidate = document.getElementById('import-validate');
                let importBusy = false;

                document.getElementById('open-import').addEventListener('click', function () {
                    importModal.hidden = false;
                });
                document.getElementById('import-pick').addEventListener('click', function () {
                    importInput.click();
                });
                document.querySelectorAll('[data-close-import]').forEach(function (element) {
                    element.addEventListener('click', closeImport);
                });
                importModal.addEventListener('click', function (event) {
                    if (event.target === importModal) closeImport();
                });
                importForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                });
                importInput.addEventListener('change', function () {
                    const file = importInput.files && importInput.files[0];
                    importName.textContent = file ? file.name : 'Ningún archivo seleccionado';
                    importResult.replaceChildren();
                    importConfirm.hidden = true;
                });
                importValidate.addEventListener('click', function () {
                    postImport(importForm.getAttribute('data-validate-url'), false);
                });
                importConfirm.addEventListener('click', function () {
                    if (!confirm('¿Importar los productos de este fichero?')) return;
                    postImport(importForm.action, true);
                });

                function postImport(url, importing) {
                    const file = importInput.files && importInput.files[0];
                    if (!file || importBusy) {
                        if (!file) showReport({ isValid: false, imported: false, documentErrors: ['Selecciona un archivo JSON.'], products: [] });
                        return;
                    }
                    importBusy = true;
                    importValidate.disabled = true;
                    importConfirm.disabled = true;
                    const token = importForm.querySelector('input[name="__RequestVerificationToken"]').value;
                    const body = new FormData();
                    body.append('__RequestVerificationToken', token);
                    body.append('importFile', file);
                    fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
                        .then(function (response) {
                            return response.json().then(function (report) { return report; });
                        })
                        .then(function (report) {
                            if (report && report.imported) {
                                window.location.assign(window.location.href);
                                return;
                            }
                            showReport(report || { isValid: false, documentErrors: ['No se ha podido leer la respuesta.'], products: [] });
                        })
                        .catch(function () {
                            showReport({ isValid: false, imported: false, documentErrors: ['No se ha podido enviar el fichero.'], products: [] });
                        })
                        .finally(function () {
                            importBusy = false;
                            importValidate.disabled = false;
                            importConfirm.disabled = false;
                        });
                }

                function showReport(report) {
                    importResult.replaceChildren();
                    importConfirm.hidden = true;
                    const title = document.createElement('p');
                    title.className = report.isValid ? 'ok-text' : 'err-text';
                    title.textContent = report.isValid ? '✓ JSON válido' : '✗ No se puede importar';
                    importResult.appendChild(title);
                    if (report.isValid && report.counts) {
                        const list = document.createElement('ul');
                        [
                            countLine(report.counts.total, 'producto', 'productos'),
                            countLine(report.counts.standard, 'estándar', 'estándar'),
                            countLine(report.counts.wine, 'vino', 'vinos'),
                            countLine(report.counts.pack, 'pack', 'packs')
                        ].forEach(function (text) {
                            const item = document.createElement('li');
                            item.textContent = text;
                            list.appendChild(item);
                        });
                        importResult.appendChild(list);
                        importConfirm.hidden = false;
                    }
                    appendMessages(null, report.documentErrors || []);
                    (report.products || []).forEach(function (group) {
                        appendMessages(group.label, group.messages || []);
                    });
                }

                function appendMessages(label, messages) {
                    if (!messages.length) return;
                    if (label) {
                        const heading = document.createElement('h3');
                        heading.textContent = label;
                        importResult.appendChild(heading);
                    }
                    const list = document.createElement('ul');
                    messages.forEach(function (message) {
                        const item = document.createElement('li');
                        item.textContent = message;
                        list.appendChild(item);
                    });
                    importResult.appendChild(list);
                }

                function countLine(value, singular, plural) {
                    return value + ' ' + (value === 1 ? singular : plural);
                }
            }

            if (editModal) {
                const editForm = document.getElementById('edit-form');
                const editError = document.getElementById('edit-error');
                const editLoading = document.getElementById('edit-loading');
                const editKind = document.getElementById('edit-kind');
                const editWine = document.getElementById('edit-wine');
                const editStock = document.getElementById('edit-stock');
                const editPack = document.getElementById('edit-pack');
                const editComponents = document.getElementById('edit-components');
                const editSave = document.getElementById('edit-save');
                let opened = null;

                function showEditError(message) {
                    editError.textContent = message;
                    editError.hidden = !message;
                }

                function closeEditNow() {
                    if (editBusy) return;
                    editModal.hidden = true;
                }

                document.querySelectorAll('[data-close-edit]').forEach(function (element) {
                    element.addEventListener('click', closeEditNow);
                });
                editModal.addEventListener('click', function (event) {
                    if (event.target === editModal) closeEditNow();
                });

                const productRowsForEdit = document.getElementById('product-rows');
                if (productRowsForEdit) productRowsForEdit.addEventListener('click', function (event) {
                    const button = event.target.closest('.js-edit-product');
                    if (!button) return;
                    openEditor(button.getAttribute('data-url'));
                });

                document.getElementById('edit-add-component').addEventListener('click', function () {
                    if (!opened) return;
                    const used = selectedComponentIds();
                    const available = opened.candidates.find(function (candidate) {
                        return used.indexOf(candidate.productId) === -1;
                    });
                    if (!available) {
                        showEditError('No quedan productos para añadir.');
                        return;
                    }
                    showEditError('');
                    addComponentRow(available.productId, 1);
                });

                editForm.addEventListener('submit', function (event) {
                    event.preventDefault();
                    saveEditor();
                });

                function openEditor(url) {
                    opened = null;
                    editBusy = false;
                    editSave.disabled = false;
                    editForm.hidden = true;
                    editLoading.hidden = false;
                    showEditError('');
                    editModal.hidden = false;
                    fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            });
                        })
                        .then(function (result) {
                            if (!result.ok) {
                                editLoading.hidden = true;
                                showEditError((result.data && result.data.message) || 'No se ha podido abrir el producto.');
                                return;
                            }
                            fillEditor(result.data);
                        })
                        .catch(function () {
                            editLoading.hidden = true;
                            showEditError('No se ha podido abrir el producto.');
                        });
                }

                function fillEditor(data) {
                    opened = {
                        id: data.id,
                        kind: data.kind,
                        revision: data.fichaRevision,
                        stock: data.stock,
                        candidates: data.candidates || []
                    };
                    document.getElementById('edit-title').textContent = data.name || 'Editar producto';
                    editKind.textContent = data.kind || '';
                    document.getElementById('edit-reference').value = data.reference || '';
                    document.getElementById('edit-name').value = data.name || '';
                    document.getElementById('edit-slug').value = data.slug || '';
                    document.getElementById('edit-description').value = data.description || '';
                    document.getElementById('edit-category').value = data.categoryId || '';
                    document.getElementById('edit-price').value = data.price || '';
                    document.getElementById('edit-vat').value = data.vatRate || '';
                    document.getElementById('edit-active').checked = !!data.active;
                    const isWine = data.kind === 'Vino';
                    const isPack = data.kind === 'Pack';
                    editWine.hidden = !isWine;
                    editStock.hidden = isPack;
                    editPack.hidden = !isPack;
                    document.getElementById('edit-vintage').value = data.vintage || '';
                    document.getElementById('edit-grape').value = data.grape || '';
                    document.getElementById('edit-alcohol').value = data.alcohol || '';
                    document.getElementById('edit-stock-input').value = data.stock == null ? '' : String(data.stock);
                    editComponents.replaceChildren();
                    if (isPack) {
                        (data.components || []).forEach(function (component) {
                            addComponentRow(component.productId, component.quantity);
                        });
                    }
                    editLoading.hidden = true;
                    editForm.hidden = false;
                }

                function addComponentRow(productId, quantity) {
                    const row = document.createElement('div');
                    row.className = 'component-row';
                    const select = document.createElement('select');
                    (opened.candidates || []).forEach(function (candidate) {
                        const option = document.createElement('option');
                        option.value = candidate.productId;
                        option.textContent = candidate.label;
                        if (candidate.productId === productId) option.selected = true;
                        select.appendChild(option);
                    });
                    if (productId) select.value = productId;
                    const quantityInput = document.createElement('input');
                    quantityInput.type = 'number';
                    quantityInput.min = '1';
                    quantityInput.step = '1';
                    quantityInput.value = String(quantity || 1);
                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'quiet';
                    remove.textContent = 'Quitar';
                    remove.addEventListener('click', function () {
                        row.remove();
                    });
                    row.appendChild(select);
                    row.appendChild(quantityInput);
                    row.appendChild(remove);
                    editComponents.appendChild(row);
                }

                function selectedComponentIds() {
                    return Array.from(editComponents.querySelectorAll('select')).map(function (select) {
                        return select.value;
                    });
                }

                function saveEditor() {
                    if (!opened || editBusy) return;
                    const tokenInput = document.querySelector('#page-antiforgery input[name="__RequestVerificationToken"]');
                    if (!tokenInput) {
                        showEditError('No se ha podido guardar el producto.');
                        return;
                    }
                    const body = new FormData();
                    body.append('__RequestVerificationToken', tokenInput.value);
                    body.append('productId', opened.id);
                    body.append('fichaRevision', opened.revision);
                    body.append('reference', document.getElementById('edit-reference').value);
                    body.append('name', document.getElementById('edit-name').value);
                    body.append('slug', document.getElementById('edit-slug').value);
                    body.append('description', document.getElementById('edit-description').value);
                    body.append('categoryId', document.getElementById('edit-category').value);
                    body.append('price', document.getElementById('edit-price').value);
                    body.append('vatRate', document.getElementById('edit-vat').value);
                    body.append('active', document.getElementById('edit-active').checked ? 'true' : 'false');
                    if (opened.kind === 'Pack') {
                        const components = Array.from(editComponents.querySelectorAll('.component-row')).map(function (row) {
                            return {
                                productId: row.querySelector('select').value,
                                quantity: Number(row.querySelector('input').value)
                            };
                        });
                        body.append('componentsJson', JSON.stringify(components));
                    } else {
                        body.append('loadedStock', opened.stock == null ? '' : String(opened.stock));
                        body.append('stock', document.getElementById('edit-stock-input').value);
                    }
                    if (opened.kind === 'Vino') {
                        body.append('vintage', document.getElementById('edit-vintage').value);
                        body.append('grape', document.getElementById('edit-grape').value);
                        body.append('alcohol', document.getElementById('edit-alcohol').value);
                    }
                    editBusy = true;
                    editSave.disabled = true;
                    showEditError('');
                    fetch(editForm.getAttribute('data-save-url'), { method: 'POST', body: body, credentials: 'same-origin' })
                        .then(function (response) {
                            return response.json().then(function (data) {
                                return { ok: response.ok, data: data };
                            }).catch(function () {
                                return { ok: false, data: null };
                            });
                        })
                        .then(function (result) {
                            if (result.ok && result.data && result.data.ok) {
                                window.location.assign(window.location.href);
                                return;
                            }
                            editBusy = false;
                            editSave.disabled = false;
                            showEditError((result.data && result.data.message) || 'No se ha podido guardar el producto.');
                        })
                        .catch(function () {
                            editBusy = false;
                            editSave.disabled = false;
                            showEditError('No se ha podido guardar el producto.');
                        });
                }
            }

            if (window.AdminLiveFilters) {
                const live = window.AdminLiveFilters;
                const categoryFilters = document.getElementById('category-filters');
                const productFilters = document.getElementById('product-filters');
                const categoryRefresh = new live.ListRefresh(function (url, options) {
                    return fetch(url, Object.assign({ credentials: 'same-origin', headers: { 'Accept': 'text/html' } }, options));
                });
                const productRefresh = new live.ListRefresh(function (url, options) {
                    return fetch(url, Object.assign({ credentials: 'same-origin', headers: { 'Accept': 'text/html' } }, options));
                });
                let categoryTimer = 0;
                let productTimer = 0;

                function fieldValue(form, name) {
                    if (!form) return '';
                    const element = form.elements.namedItem(name);
                    return element ? String(element.value || '') : '';
                }

                function currentFields() {
                    return {
                        categoryQuery: fieldValue(categoryFilters, 'categoryQuery'),
                        categoryActive: fieldValue(categoryFilters, 'categoryActive'),
                        categoryParent: fieldValue(categoryFilters, 'categoryParent'),
                        productQuery: fieldValue(productFilters, 'productQuery'),
                        productCategory: fieldValue(productFilters, 'productCategory'),
                        productKind: fieldValue(productFilters, 'productKind'),
                        productActive: fieldValue(productFilters, 'productActive')
                    };
                }

                function writeFields(fields) {
                    Object.keys(fields).forEach(function (name) {
                        const form = name.indexOf('category') === 0 ? categoryFilters : productFilters;
                        const element = form && form.elements.namedItem(name);
                        if (element) element.value = fields[name];
                    });
                }

                function syncHidden(form, names, fields) {
                    if (!form) return;
                    names.forEach(function (name) {
                        let input = form.querySelector('input[type="hidden"][name="' + name + '"]');
                        const value = (fields[name] || '').trim();
                        if (!value) {
                            if (input) input.remove();
                            return;
                        }
                        if (!input) {
                            input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = name;
                            form.appendChild(input);
                        }
                        input.value = value;
                    });
                }

                function applyFragment(html, fragmentId, rowsId, countId) {
                    const parsed = new DOMParser().parseFromString(html, 'text/html');
                    const fragment = parsed.getElementById(fragmentId);
                    const rows = document.getElementById(rowsId);
                    if (!fragment || !rows) throw new Error('fragment');
                    const block = rows.closest('.live-results');
                    const section = rows.closest('section');
                    const scrollX = window.scrollX;
                    const scrollY = window.scrollY;
                    const sectionBottom = section ? section.getBoundingClientRect().bottom : 0;
                    const heightBefore = block ? block.offsetHeight : 0;
                    const documentHeight = document.documentElement.scrollHeight;
                    const active = document.activeElement;
                    let focusVisibleInSection = false;
                    if (active && section && section.contains(active) && !rows.contains(active) && active.getBoundingClientRect) {
                        const rect = active.getBoundingClientRect();
                        focusVisibleInSection = rect.bottom > 0 && rect.top < window.innerHeight;
                    }
                    const keepBelow = live.keepContentBelow(sectionBottom, window.innerHeight, focusVisibleInSection);
                    document.body.classList.add('list-updating');
                    if (block) block.style.minHeight = heightBefore + 'px';
                    rows.replaceChildren(fragment.content.cloneNode(true));
                    const table = rows.closest('table');
                    const heightAfter = table ? table.offsetHeight : heightBefore;
                    const plan = live.planViewport({
                        scrollY: scrollY,
                        viewportHeight: window.innerHeight,
                        sectionBottom: sectionBottom,
                        keepBelow: keepBelow,
                        heightBefore: heightBefore,
                        heightAfter: heightAfter,
                        documentHeight: documentHeight
                    });
                    if (block) {
                        if (plan.minHeight > 0) {
                            block.style.minHeight = plan.minHeight + 'px';
                            block.dataset.naturalHeight = String(heightAfter);
                        } else {
                            block.style.minHeight = '';
                            delete block.dataset.naturalHeight;
                        }
                    }
                    if (window.scrollX !== scrollX || Math.abs(window.scrollY - plan.scrollY) > 0.5) {
                        window.scrollTo(scrollX, plan.scrollY);
                    }
                    document.body.classList.remove('list-updating');
                    const count = document.getElementById(countId);
                    if (count) count.textContent = fragment.getAttribute('data-count') || '0';
                }

                function releaseReservations() {
                    document.querySelectorAll('.live-results[data-natural-height]').forEach(function (block) {
                        const natural = Number(block.dataset.naturalHeight) || 0;
                        if (!live.canReleaseReservation({
                            scrollY: window.scrollY,
                            viewportHeight: window.innerHeight,
                            visualHeight: block.offsetHeight,
                            naturalHeight: natural,
                            documentHeight: document.documentElement.scrollHeight
                        })) return;
                        block.style.minHeight = '';
                        delete block.dataset.naturalHeight;
                    });
                }

                window.addEventListener('scroll', releaseReservations, { passive: true });

                function setStatus(id, visible) {
                    const element = document.getElementById(id);
                    if (element) element.hidden = !visible;
                }

                function setFilterError(id, message) {
                    const element = document.getElementById(id);
                    if (!element) return;
                    element.textContent = message || '';
                    element.hidden = !message;
                }

                function publish(fields) {
                    const params = live.catalogQuery(fields);
                    const next = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
                    window.history.replaceState(null, '', next);
                    syncHidden(categoryFilters, ['productQuery', 'productCategory', 'productKind', 'productActive'], fields);
                    syncHidden(productFilters, ['categoryQuery', 'categoryActive', 'categoryParent'], fields);
                    return params;
                }

                function refreshRows(kind) {
                    const fields = currentFields();
                    const params = publish(fields);
                    params.set('handler', kind === 'category' ? 'CategoryRows' : 'ProductRows');
                    const url = window.location.pathname + '?' + params.toString();
                    const refresher = kind === 'category' ? categoryRefresh : productRefresh;
                    const statusId = kind === 'category' ? 'category-filter-status' : 'product-filter-status';
                    const errorId = kind === 'category' ? 'category-filter-error' : 'product-filter-error';
                    setStatus(statusId, true);
                    setFilterError(errorId, '');
                    let current = null;
                    return refresher.run(url).then(function (result) {
                        current = result;
                        if (!result || result.aborted || result.stale || result.generation !== refresher.generation) return;
                        if (result.failed || !result.response || !result.response.ok) throw new Error('search');
                        return result.response.text().then(function (html) {
                            if (result.generation !== refresher.generation) return;
                            if (kind === 'category') applyFragment(html, 'category-fragment', 'category-rows', 'category-count');
                            else applyFragment(html, 'product-fragment', 'product-rows', 'product-count');
                        });
                    }).catch(function () {
                        if (current && current.generation === refresher.generation) {
                            setFilterError(errorId, 'No se ha podido actualizar el listado.');
                        }
                    }).finally(function () {
                        if (current && current.generation === refresher.generation) setStatus(statusId, false);
                    });
                }

                function schedule(kind, control) {
                    const delay = live.refreshDelay(control);
                    const timer = kind === 'category' ? categoryTimer : productTimer;
                    window.clearTimeout(timer);
                    const run = function () { refreshRows(kind); };
                    if (delay === 0) run();
                    else if (kind === 'category') categoryTimer = window.setTimeout(run, delay);
                    else productTimer = window.setTimeout(run, delay);
                }

                function bindFilters(form, kind) {
                    if (!form) return;
                    form.addEventListener('input', function (event) {
                        if (event.target && event.target.tagName === 'INPUT') schedule(kind, 'input');
                    });
                    form.addEventListener('change', function (event) {
                        if (event.target && event.target.tagName === 'SELECT') schedule(kind, 'select');
                    });
                    form.addEventListener('submit', function (event) {
                        event.preventDefault();
                        schedule(kind, 'submit');
                    });
                }

                bindFilters(categoryFilters, 'category');
                bindFilters(productFilters, 'product');
                const clearCategories = document.getElementById('clear-category-filters');
                const clearProducts = document.getElementById('clear-product-filters');
                if (clearCategories) clearCategories.addEventListener('click', function (event) {
                    event.preventDefault();
                    writeFields(live.clearFields(currentFields(), 'category'));
                    schedule('category', 'clear');
                });
                if (clearProducts) clearProducts.addEventListener('click', function (event) {
                    event.preventDefault();
                    writeFields(live.clearFields(currentFields(), 'product'));
                    schedule('product', 'clear');
                });
            }
        })();
    </script>
</body>
</html>
