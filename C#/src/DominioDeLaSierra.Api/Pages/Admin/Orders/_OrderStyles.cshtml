<style>
    :root { --wine:#421f25; --ink:#1d1917; --paper:#faf8f4; --cream:#f2ede4; --gold:#bd9560; --line:rgba(29,25,23,.14); --ok:#2f6b4f; --err:#8b2e35; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 15px/1.5 Calibri, Segoe UI, sans-serif; }
    header.page { background: var(--wine); color: #faf7f1; padding: 28px 32px; }
    header.page p { margin: 0 0 6px; letter-spacing: .18em; text-transform: uppercase; font-size: 11px; color: var(--gold); }
    header.page h1 { margin: 0; font-weight: 500; font-size: 28px; }
    header.page small { display: block; margin-top: 8px; opacity: .75; }
    .wrap { padding: 28px 32px 48px; }
    .flash { padding: 12px 14px; border-radius: 8px; margin-bottom: 18px; }
    .flash.ok { background: #e7f3ea; color: var(--ok); }
    .flash.err { background: #f8e8e9; color: var(--err); }
    section.card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 20px; margin-bottom: 18px; }
    h2 { margin: 0 0 14px; font-size: 18px; color: var(--wine); }
    label { display: block; font-size: 12px; font-weight: 600; margin: 0 0 4px; }
    input, select { width: 100%; padding: 9px 10px; border: 1px solid var(--line); border-radius: 8px; font: inherit; background: var(--cream); }
    button, .clear-link { background: var(--wine); color: #fff; border: 0; border-radius: 999px; padding: 10px 18px; font: 600 14px inherit; cursor: pointer; text-decoration: none; }
    .clear-link { background: transparent; color: var(--wine); border: 1px solid var(--wine); }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #6d6560; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; white-space: nowrap; }
    .badge.paid, .badge.prepared { background: #e7f3ea; color: var(--ok); }
    .badge.pending { background: #f8f1e4; color: #8a6230; }
    .badge.closed { background: #f8e8e9; color: var(--err); }
    .badge.preparing { background: #e8eef8; color: #2c4a7a; }
    .badge.shipped { background: #e7f4f2; color: #1f5c56; }
    .badge.unfulfilled { background: #f2ede4; color: #6d6560; }
    .muted { color: #756c65; font-size: 13px; }
    a.order-link { color: var(--wine); font-weight: 650; text-decoration: none; }
    .filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin: 0 0 14px; }
    .filter-field { flex: 1 1 150px; min-width: 140px; }
    .filter-field.grow { flex: 2 1 220px; }
    .filters button, .filters .clear-link { padding: 9px 14px; font-size: 13px; }
    .filter-status, .filter-error { min-height: 0; margin: 0 0 10px; font-size: 13px; }
    .filter-status { color: #756c65; }
    .filter-error { color: var(--err); }
    .pager { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 14px; }
    .pager a, .pager span { padding: 6px 10px; border-radius: 999px; text-decoration: none; font-size: 13px; }
    .pager a { color: var(--wine); border: 1px solid var(--line); }
    .pager .current { background: var(--wine); color: #fff; }
    .table-scroll { overflow-x: auto; }
    .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px 18px; margin: 0; }
    .facts dt { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #6d6560; }
    .facts dd { margin: 2px 0 0; }
    .components { margin: 6px 0 0; padding-left: 16px; color: #756c65; }
    .ship-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end; }
    .ship-form .full { grid-column: 1 / -1; }
    .back { color: var(--wine); text-decoration: none; font-size: 13px; }
    @@media (max-width: 720px) {
        header.page, .wrap { padding-left: 16px; padding-right: 16px; }
        .ship-form { grid-template-columns: 1fr; }
    }
</style>
