{
  "name": "dominio-de-la-sierra-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "ng serve",
    "preview": "ng serve --configuration preview --host 127.0.0.1 --port 4301",
    "build": "ng build",
    "test": "node --experimental-strip-types --test src/app/core/wine-display.spec.ts src/app/core/checkout.spec.ts",
    "build:hostinger": "ng build --configuration production,preview --optimization --source-map=false --output-hashing=all",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "^19.2.15",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.15",
    "typescript": "~5.8.3"
  }
}
